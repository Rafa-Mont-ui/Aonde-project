# Long random string used to sign logins. Use a different one in production.
PAYLOAD_SECRET=troque-por-um-valor-aleatorio-longo

# Local: SQLite file. Production (Vercel + Neon): the postgres:// URL that the
# Neon integration creates automatically.
DATABASE_URL=file:./aonde.db

# Only needed to send uploads to Vercel Blob (set automatically on Vercel).
# BLOB_READ_WRITE_TOKEN=

# Optional: custom domain for social previews. Defaults to the Vercel domain.
# NEXT_PUBLIC_SITE_URL=https://seu-dominio.com.br
